<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Name: <%= user.name %></p>
    <p>Username: <%= user.email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p>
            <a href="/users">View Registered Users</a>
        </p>
    <% } %>


    <h2>Your Volunteer Projects</h2>

    <% if (volunteerProjects.length > 0) { %>

        <ul>

            <% volunteerProjects.forEach(project => { %>

                <li>

                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>

                    <form
                        action="/project/<%= project.project_id %>/remove-volunteer"
                        method="POST">

                        <button type="submit">
                            Remove
                        </button>

                    </form>

                </li>

            <% }) %>

        </ul>

    <% } else { %>

        <p>
            You have not signed up for any projects.
        </p>

    <% } %>

</main>

<%- include('partials/footer') %>