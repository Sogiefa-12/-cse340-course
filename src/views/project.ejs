<%- include('partials/header') %>

    <main>

        <h1>
            <%= project.title %>
        </h1>

        <p>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>

            <%= new Date(project.project_date).toLocaleDateString() %>
        </p>

        <p>
            <strong>Location:</strong>

            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>

            <a href="/organization/<%= project.organization_id %>">

                <%= project.organization_name %>

            </a>
        </p>

        <section class="categories">

            <h2>Categories</h2>

            <div class="category-tags">

                <% categories.forEach(category=> { %>

                    <a class="category-tag" href="/category/<%= category.category_id %>">

                        <%= category.category_name %>

                    </a>

                    <% }) %>

            </div>

        </section>
        <% if (user && user.role_name === 'admin') { %>
           
            <p>
                <a href="/edit-project/<%= project.project_id %>">
                    Edit Project
                </a>
            </p>

             <p>
                <a href="/assign-categories/<%= project.project_id %>">
                    Edit Categories
                </a>
            </p>
     
        <% } %>

        

        <% if (user) { %>

            <% if (!isUserVolunteer) { %>

                <form
                    action="/project/<%= project.project_id %>/volunteer"
                    method="POST">

                    <button type="submit">
                        Volunteer for this Project
                    </button>

                </form>

            <% } else { %>

                <p>
                    You are volunteering for this project.
                </p>

                <form
                    action="/project/<%= project.project_id %>/remove-volunteer"
                    method="POST">

                    <button type="submit">
                        Stop Volunteering
                    </button>

                </form>

            <% } %>

        <% } %>
    </main>

    <%- include('partials/footer') %>