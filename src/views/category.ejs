<%- include('partials/header') %>

    <main>

        <h1>
            <%= category.category_name %>
        </h1>

        <p>
            <a href="/edit-category/<%= category.category_id %>">
                Edit Category
            </a>
        </p>

        <ul>

            <% projects.forEach(project=> { %>

                <li>

                    <a href="/project/<%= project.project_id %>">

                        <%= project.title %>

                    </a>

                </li>

                <% }) %>

        </ul>

    </main>

    <%- include('partials/footer') %>