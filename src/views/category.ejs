<%- include('partials/header') %>

    <main>

        <h1>
            <%= category.category_name %>
        </h1>

        <% if (user && user.role_name === 'admin') { %>
            <a href="/category/<%= category.category_id %>/edit">
                Edit Category
            </a>
        <% } %>

        <ul>

            <% projects.forEach(project=> { %>

                <li>

                    <a href="/project/<%= project.project_id %>">

                        <%= project.title %>

                    </a>

                </li>

                <% }) %>

        </ul>

    </main>

    <%- include('partials/footer') %>